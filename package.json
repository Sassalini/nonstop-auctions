{
  "name": "nonstop-auctions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "build:cloudflare": "npm run build:worker",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --keep-vars",
    "upload": "opennextjs-cloudflare build && wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "test": "node --no-warnings --test tests/*.test.mjs",
    "test:database": "node --no-warnings --test tests/database.test.mjs",
    "test:browser": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.147.0"
  }
}

# Required from your Supabase project settings.
# Add these in Cloudflare Workers build variables/secrets too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Keep false in production. Demo mode only works with BOTH public
# Supabase variables absent; configured Supabase ALWAYS takes precedence.
AUCTION_DEMO_MODE=false

# Used by OpenNext/Wrangler local preview to load development env files.
NEXTJS_ENV=development

# Optional Stripe sandbox checkout and Connect. Leave disabled in production.
# Use a dedicated staging Supabase project and a Stripe sandbox test key.
STRIPE_TEST_CHECKOUT_ENABLED=false
STRIPE_TEST_APP_ORIGIN=
STRIPE_TEST_SUPABASE_URL=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Auction scheduling runs in the database and does not require these secrets.

# Required from your Supabase project settings.
# Add these in Cloudflare Workers build variables/secrets too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Keep false in production. Demo mode only works with BOTH public
# Supabase variables absent; configured Supabase ALWAYS takes precedence.
AUCTION_DEMO_MODE=false

# Used by OpenNext/Wrangler local preview to load development env files.
NEXTJS_ENV=development

# No service-role/secret key is required by this app. Scheduling runs in the database.
